# Copy to .env (git-ignored) and fill in. Never commit real secrets.
# PostgreSQL (recommended, Blueprint section K):
# DATABASE_URL=postgresql+psycopg://novahaus:password@localhost:5432/novahaus
DATABASE_URL=sqlite:///./novahaus.db
# Long random string; admin endpoints are disabled while this is empty.
ADMIN_TOKEN=
# Shipping rule in pence (ASSUMPTION until carrier rates are known).
SHIPPING_FEE=395
FREE_SHIPPING_THRESHOLD=5000
# Stripe TEST keys (sk_test_..., whsec_...). Checkout runs without payment while empty.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Where Stripe sends shoppers back after payment.
PUBLIC_BASE_URL=http://localhost:3000

# --- Automation: runs while the shop is running (see Admin > Automation) ---
AUTOMATION_ENABLED=true
# Act WITHOUT asking only within these limits; bigger actions wait in Admin > Approvals.
AUTO_REORDER_MAX=10000
AUTO_REORDER_WEEKLY_MAX=30000
AUTO_PRICE_MAX_PCT=5
MIN_CONTRIBUTION_MARGIN=0.35
PENDING_PAYMENT_TIMEOUT_MINUTES=90
BACKUP_HOUR=2
REPORT_HOUR=6

# --- Safety ---
# Set to "production" on a live server: checkout refuses to run without Stripe
# (never gives orders away) and the API docs pages are hidden.
ENVIRONMENT=development
# The shared ADMIN_TOKEN stops working once a personal owner login exists.
# Set true only if you really need it to keep working.
ADMIN_TOKEN_ALWAYS=false
# Automatic nightly backups keep this many newest (0 = keep all). Manual backups never delete.
BACKUP_KEEP=60
CART_TTL_DAYS=30

# --- Email (Blueprint section I) ---
# "outbox": nothing is sent; every email waits in Admin > Emails (safe default).
# "smtp": send through the SMTP service below.
EMAIL_MODE=outbox
EMAIL_FROM=NOVAHAUS <hello@example.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Long random string that signs unsubscribe and review links. Required in production.
SECRET_KEY=
# Shown in every email footer (UK law: who you are and where).
SHOP_LEGAL_NAME=NOVAHAUS
SHOP_ADDRESS=
